---
interface Props {
  name: string;
  error?: string;
  required?: boolean;
  checked?: boolean;
  value?: string;
}

const { name, error, required = false, checked = false, value = '1' } = Astro.props;
const id = `field-${name}`;
const errorId = `${id}-error`;
---

<div class="checkbox-field" data-field={name}>
  <label class="checkbox" for={id}>
    <input
      id={id}
      name={name}
      type="checkbox"
      value={value}
      checked={checked}
      required={required}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={error ? errorId : undefined} />
    <span class="checkbox__box" aria-hidden="true"></span>
    <span class="checkbox__label"><slot /></span>
  </label>
  {error && (
    <p class="checkbox-field__error" id={errorId} role="alert">{error}</p>
  )}
</div>

<style>
  .checkbox-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .checkbox {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text);
  }

  .checkbox input {
    position: absolute;
    top: 1px;
    left: 0;
    width: 22px;
    height: 22px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
  }

  .checkbox__box {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border: 2px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition), background-color var(--transition);
  }

  .checkbox input:checked + .checkbox__box {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .checkbox input:checked + .checkbox__box::after {
    content: '';
    width: 12px;
    height: 6px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(-45deg) translateY(-1px);
  }

  .checkbox input:focus-visible + .checkbox__box {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .checkbox input[aria-invalid='true'] + .checkbox__box {
    border-color: var(--color-error);
  }

  .checkbox__label :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .checkbox-field__error {
    font-size: 13px;
    color: var(--color-error);
  }
</style>
