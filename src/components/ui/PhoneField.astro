---
interface Props {
  name?: string;
  label?: string;
  error?: string;
}

const { name = 'phone', label = 'Телефон', error } = Astro.props;
const id = `field-${name}`;
const errorId = `${id}-error`;
---

<div class="field" data-field={name}>
  <label class="field__label" for={id}>
    {label}
    <span class="field__req" aria-hidden="true"> *</span>
  </label>
  <input
    id={id}
    name={name}
    class="field__control"
    type="tel"
    inputmode="tel"
    autocomplete="tel"
    maxlength="19"
    placeholder="+375 29 123-45-67"
    data-phone-input
    required
    aria-describedby={error ? errorId : undefined}
    aria-invalid={error ? 'true' : undefined} />
  {error && (
    <p class="field__error" id={errorId} role="alert">{error}</p>
  )}
</div>

<script>
  import { formatBelarusPhone } from '@/lib/phone';

  function initPhoneInputs(): void {
    for (const input of document.querySelectorAll<HTMLInputElement>('[data-phone-input]')) {
      if (input.dataset.phoneBound) continue;
      input.dataset.phoneBound = '1';
      input.addEventListener('input', () => {
        input.value = formatBelarusPhone(input.value);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPhoneInputs);
  } else {
    initPhoneInputs();
  }
</script>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field__label {
    font-weight: 600;
    font-size: 14px;
    color: var(--color-ink);
  }

  .field__req {
    color: var(--color-accent);
  }

  .field__control {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 16px;
    transition: border-color var(--transition);
  }

  .field__control:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .field__control[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .field__error {
    font-size: 13px;
    color: var(--color-error);
  }
</style>
