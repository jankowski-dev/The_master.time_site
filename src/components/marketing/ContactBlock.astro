---
import { site } from '@/lib/content';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
---

<section class="contacts" id="contacts">
  <div class="container">
    <h2 class="contacts__title">Контакты</h2>
    <p class="contacts__lead">
      Позвоните или напишите — уточню детали, назову цену и подберу удобное время.
    </p>

    <div class="contacts__grid">
      <a class="contacts__card" href={`tel:${site.phoneLink}`}>
        <span class="contacts__icon"><Icon name="btn-call" size={22} /></span>
        <span class="contacts__label">Телефон</span>
        <span class="contacts__value">{site.phoneDisplay}</span>
      </a>

      <a class="contacts__card" href={site.viberUrl}>
        <span class="contacts__icon"><Icon name="menu-viber" size={22} /></span>
        <span class="contacts__label">Viber</span>
        <span class="contacts__value">Написать в Viber</span>
      </a>

      <a class="contacts__card" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">
        <span class="contacts__icon"><Icon name="menu-instagram" size={22} /></span>
        <span class="contacts__label">Instagram</span>
        <span class="contacts__value">Написать в директ</span>
      </a>

      <div class="contacts__card">
        <span class="contacts__icon"><Icon name="flag" size={22} /></span>
        <span class="contacts__label">Зона выезда</span>
        <span class="contacts__value">{site.areaServed}</span>
        <span class="contacts__sub">{site.workingHours}</span>
      </div>
    </div>

    <div class="contacts__cta">
      <Button href="/kalkulyator" variant="primary" size="lg">Рассчитать стоимость</Button>
    </div>
  </div>
</section>

<style>
  .contacts {
    background: var(--color-surface-alt);
  }

  .contacts__title {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 900;
    margin-bottom: 12px;
  }

  .contacts__lead {
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.6;
    max-width: 560px;
    margin-bottom: 32px;
  }

  .contacts__grid {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
    margin-bottom: 32px;
  }

  .contacts__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 24px;
    color: var(--color-text);
    transition: border-color var(--transition);
  }

  a.contacts__card:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .contacts__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    margin-bottom: 6px;
  }

  .contacts__label {
    color: var(--color-muted);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .contacts__value {
    font-weight: 700;
    font-size: 17px;
  }

  .contacts__sub {
    color: var(--color-muted);
    font-size: 14px;
  }

  @media (min-width: 640px) {
    .contacts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .contacts__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
