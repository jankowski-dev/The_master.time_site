---
import { site } from '@/lib/content';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
---

<section class="instagram-block" id="instagram">
  <div class="container">
    <div class="instagram-block__card">
      <div class="instagram-block__content">
        <h2 class="instagram-block__title">Сфотографируй проблему — пришли в директ</h2>
        <p class="instagram-block__text">
          Пришлите фото — назову примерную цену и срок ещё до выезда. Подписчикам Instagram —
          приоритет в очереди на выезд.
        </p>
        <div class="instagram-block__actions">
          <Button
            href={site.instagramDm}
            variant="primary"
            size="lg"
            data-track
            data-track-event="instagram_click"
            data-track-params='{"placement":"home"}'
          >
            Отправить фото
          </Button>
          <Button
            href={site.instagramUrl}
            variant="ghost"
            size="lg"
            class="instagram-block__follow"
            data-track
            data-track-event="instagram_click"
            data-track-params='{"placement":"home"}'
          >
            Подписаться
          </Button>
        </div>
      </div>
      <div class="instagram-block__graphic" aria-hidden="true">
        <span class="instagram-block__camera"><Icon name="instagram" size={56} /></span>
        <span class="instagram-block__ring"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .instagram-block__card {
    display: grid;
    gap: 32px;
    align-items: center;
    background:
      radial-gradient(480px 320px at 100% 0%, rgba(199, 69, 44, 0.32), transparent 60%),
      var(--color-ink);
    color: #ffffff;
    border-radius: var(--radius-xl);
    padding: clamp(32px, 5vw, 56px);
  }

  .instagram-block__title {
    color: #ffffff;
    font-size: clamp(22px, 3.5vw, 32px);
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 16px;
    max-width: 520px;
  }

  .instagram-block__text {
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 28px;
    max-width: 520px;
  }

  .instagram-block__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .instagram-block__follow {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .instagram-block__follow:hover {
    border-color: #ffffff;
    color: #ffffff;
  }

  .instagram-block__graphic {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
  }

  .instagram-block__camera {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    border-radius: var(--radius-lg);
    background: var(--color-accent);
    color: #ffffff;
  }

  .instagram-block__ring {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 767px) {
    .instagram-block__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .instagram-block__graphic {
      order: -1;
      min-height: 120px;
    }
  }

  @media (min-width: 768px) {
    .instagram-block__card {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
