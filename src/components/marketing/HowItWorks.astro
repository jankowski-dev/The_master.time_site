---
interface Step {
  num: string;
  title: string;
  text: string;
}

const steps: Step[] = [
  {
    num: '01',
    title: 'Опишите задачу',
    text: 'Позвоните или напишите в Instagram/Viber — что нужно сделать и где.'
  },
  {
    num: '02',
    title: 'Согласуем цену',
    text: 'Подтверждаем стоимость и время до начала работ. Без сюрпризов.'
  },
  {
    num: '03',
    title: 'Мастер приедет',
    text: 'Быстрый выезд по Гродно и аккуратная работа.'
  }
];
---

<section class="how" id="how-it-works">
  <div class="container">
    <h2 class="how__title">Как это работает</h2>
    <ol class="how__steps">
      {
        steps.map((step) => (
          <li class="how__step">
            <span class="how__num">{step.num}</span>
            <h3 class="how__step-title">{step.title}</h3>
            <p class="how__step-text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    background: var(--color-surface-alt);
  }

  .how__title {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 900;
    margin-bottom: 32px;
  }

  .how__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }

  .how__step {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .how__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #ffffff;
    font-weight: 700;
    font-size: 15px;
  }

  .how__step-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .how__step-text {
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .how__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
