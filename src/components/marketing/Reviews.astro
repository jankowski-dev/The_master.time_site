---
import { site } from '@/lib/content';
import ReviewCard from './ReviewCard.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Review } from '@/lib/content/schemas';

interface Props {
  reviews: Review[];
  id?: string;
}

const { reviews, id = 'reviews' } = Astro.props;
---

<section class="reviews" id={id}>
  <div class="container">
    <h2 class="reviews__title">Отзывы</h2>
    {
      reviews.length === 0 ? (
        <div class="reviews__empty">
          <span class="reviews__empty-icon"><Icon name="reviews" size={32} /></span>
          <p class="reviews__empty-title">Здесь будут реальные отзывы.</p>
          <p class="reviews__empty-text">
            Пока — фото работ и отзывы клиентов смотрите в Instagram.
          </p>
          <a class="reviews__empty-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">
            Открыть Instagram
          </a>
        </div>
      ) : (
        <div class="reviews__grid">
          {reviews.map((review) => <ReviewCard review={review} />)}
        </div>
      )
    }
  </div>
</section>

<style>
  .reviews__title {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 900;
    margin-bottom: 32px;
  }

  .reviews__grid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }

  .reviews__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    max-width: 480px;
    margin-inline: auto;
    background: var(--color-surface);
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-lg);
    padding: 40px 24px;
  }

  .reviews__empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    margin-bottom: 4px;
  }

  .reviews__empty-title {
    font-weight: 700;
    font-size: 18px;
  }

  .reviews__empty-text {
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .reviews__empty-link {
    margin-top: 8px;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .reviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .reviews__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
