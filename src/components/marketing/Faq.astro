---
import Accordion from '@/components/ui/Accordion.astro';
import type { FaqItem } from '@/lib/content/schemas';

interface Props {
  items: FaqItem[];
  title?: string;
  id?: string;
}

const { items, title = 'Частые вопросы', id = 'faq' } = Astro.props;
---

<section class="faq" id={id}>
  <div class="container">
    <h2 class="faq__title">{title}</h2>
    <div class="faq__body">
      <Accordion items={items} />
    </div>
  </div>
</section>

<style>
  .faq__title {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 900;
    margin-bottom: 24px;
  }

  .faq__body {
    max-width: 760px;
  }
</style>
