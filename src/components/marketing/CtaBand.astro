---
import { site } from '@/lib/content';
import Button from '@/components/ui/Button.astro';

interface Props {
  title: string;
  text?: string;
  primaryHref?: string;
  primaryLabel?: string;
  id?: string;
}

const {
  title,
  text,
  primaryHref = '/kalkulyator',
  primaryLabel = 'Рассчитать',
  id = 'cta'
} = Astro.props;
---

<section class="cta-band" id={id}>
  <div class="container cta-band__inner">
    <div class="cta-band__content">
      <h2 class="cta-band__title">{title}</h2>
      {text && <p class="cta-band__text">{text}</p>}
    </div>
    <div class="cta-band__actions">
      <Button href={primaryHref} variant="primary" size="lg">{primaryLabel}</Button>
      <Button
        href={`tel:${site.phoneLink}`}
        variant="ghost"
        size="lg"
        class="cta-band__call"
        data-track
        data-track-event="phone_click"
        data-track-params='{"placement":"cta"}'>
        Позвонить
      </Button>
      <a class="cta-band__lead" href="/zayavka" data-open-lead-form data-lead-placement="cta">Оставить заявку</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background:
      radial-gradient(720px 320px at 15% 0%, rgba(234, 98, 73, 0.3), transparent 60%),
      var(--color-ink);
    color: #ffffff;
  }

  .cta-band__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cta-band__title {
    color: #ffffff;
    font-size: clamp(22px, 3.5vw, 32px);
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .cta-band__text {
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.6;
    max-width: 560px;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .cta-band__call {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .cta-band__call:hover {
    border-color: #ffffff;
    color: #ffffff;
  }

  .cta-band__lead {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-pill);
    color: #ffffff;
    font-weight: 700;
    font-size: 17px;
    line-height: 1;
    transition: border-color var(--transition);
  }

  .cta-band__lead:hover {
    border-color: #ffffff;
    color: #ffffff;
  }

  @media (max-width: 767px) {
    .cta-band__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (min-width: 768px) {
    .cta-band__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .cta-band__content {
      max-width: 60%;
    }
  }
</style>
