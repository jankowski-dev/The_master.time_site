---
import PriceRow from './PriceRow.astro';
import type { PopularWork } from '@/lib/content';
import type { PricingConfig, Work } from '@/lib/content/schemas';

interface Props {
  works: Array<Work | PopularWork>;
  pricing: PricingConfig;
  title?: string;
  lead?: string;
  id?: string;
}

const {
  works,
  pricing,
  title = 'Популярные работы',
  lead = 'Ориентировочные цены за работу без учёта материалов.',
  id = 'prices'
} = Astro.props;

const rows = works.map((entry) =>
  'work' in entry ? { work: entry.work, category: entry.category } : { work: entry, category: undefined }
);
---

<section class="price-table-section" id={id}>
  <div class="container">
    <div class="price-table-section__head">
      <h2 class="price-table-section__title">{title}</h2>
      <p class="price-table-section__lead">{lead}</p>
    </div>
    <div class="price-table">
      {rows.map(({ work, category }) => <PriceRow work={work} category={category} pricing={pricing} />)}
    </div>
    <p class="price-table-section__disclaimer">{pricing.disclaimer}</p>
  </div>
</section>

<style>
  .price-table-section__head {
    max-width: 640px;
    margin-bottom: 32px;
  }

  .price-table-section__title {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 900;
    margin-bottom: 12px;
  }

  .price-table-section__lead {
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .price-table {
    display: grid;
    gap: 12px;
  }

  .price-table-section__disclaimer {
    margin-top: 16px;
    color: var(--color-muted);
    font-size: 13px;
  }
</style>
