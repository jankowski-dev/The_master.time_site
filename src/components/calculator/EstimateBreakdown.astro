---
import { formatPrice } from '@/lib/pricing/format';
import type { Estimate } from '@/lib/pricing/types';

interface Props {
  estimate: Estimate;
}

const { estimate } = Astro.props;

// Base example: the work line plus the surcharge rules that apply on top.
const workLine = estimate.lines[0];

const lineAmount = (line: { label: string; from: number; to?: number }): string => {
  if (line.to !== undefined && line.to !== line.from) {
    return `${formatPrice(line.from)}–${formatPrice(line.to)}`;
  }
  return formatPrice(line.from);
};
---

<section class="estimate-breakdown" id="how-price-works">
  <div class="container">
    <h2 class="estimate-breakdown__title">Как считается цена</h2>
    <p class="estimate-breakdown__lead">
      Цена складывается из базовой работы и доплат за срочность и выезд. Ниже — наглядный пример
      по работе «Замена смесителя» в Гродно.
    </p>

    <ul class="estimate-breakdown__list">
      {workLine && (
        <li class="estimate-breakdown__item">
          <span class="estimate-breakdown__label">{workLine.label}</span>
          <strong class="estimate-breakdown__value">{lineAmount(workLine)}</strong>
        </li>
      )}
      <li class="estimate-breakdown__item">
        <span class="estimate-breakdown__label">Срочность</span>
        <strong class="estimate-breakdown__value">+20% к работе</strong>
      </li>
      <li class="estimate-breakdown__item">
        <span class="estimate-breakdown__label">За городом (до 20 км)</span>
        <strong class="estimate-breakdown__value">+20 BYN</strong>
      </li>
      <li class="estimate-breakdown__item">
        <span class="estimate-breakdown__label">Диагностика</span>
        <strong class="estimate-breakdown__value">зачитывается в работу</strong>
      </li>
    </ul>

    <p class="estimate-breakdown__note">
      {estimate.disclaimer} Точный расчёт по вашей задаче — в калькуляторе выше.
    </p>
  </div>
</section>

<style>
  .estimate-breakdown {
    background: var(--color-surface-alt);
  }

  .estimate-breakdown__title {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 900;
    margin-bottom: 12px;
  }

  .estimate-breakdown__lead {
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.6;
    max-width: 680px;
    margin-bottom: 24px;
  }

  .estimate-breakdown__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    max-width: 720px;
  }

  .estimate-breakdown__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  .estimate-breakdown__label {
    color: var(--color-text);
    font-size: 15px;
  }

  .estimate-breakdown__value {
    color: var(--color-ink);
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }

  .estimate-breakdown__note {
    margin-top: 16px;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.55;
    max-width: 720px;
  }
</style>
