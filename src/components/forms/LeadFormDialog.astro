---
import LeadForm from '@/components/forms/LeadForm.astro';
---

<dialog class="lead-dialog" id="lead-form-dialog" aria-labelledby="lead-dialog-title">
  <div class="lead-dialog__panel">
    <button
      class="lead-dialog__close"
      type="button"
      data-lead-dialog-close
      aria-label="Закрыть окно заявки">&times;</button>
    <h2 class="lead-dialog__title" id="lead-dialog-title">Оставить заявку</h2>
    <p class="lead-dialog__lead">
      Оставьте номер — перезвоню, уточню детали и назову цену. Фото можно прикрепить.
    </p>
    <LeadForm source="form" inDialog />
  </div>
</dialog>

<script>
  interface OpenLeadFormDetail {
    source?: string;
    categorySlug?: string;
    taskId?: string;
    urgency?: string;
    location?: string;
    estimateFrom?: number;
    estimateTo?: number;
    message?: string;
  }

  function initLeadDialog(): void {
    const dialog = document.querySelector<HTMLDialogElement>('#lead-form-dialog');
    if (!dialog) return;
    const form = dialog.querySelector<HTMLFormElement>('[data-lead-form]');
    const phone = form?.querySelector<HTMLInputElement>('[data-phone-input]');

    const setField = (name: string, value: string): void => {
      const input = form?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
      if (input) input.value = value;
    };

    const applyPreset = (detail?: OpenLeadFormDetail): void => {
      setField('source', detail?.source ?? 'form');
      setField('categorySlug', detail?.categorySlug ?? '');
      setField('taskId', detail?.taskId ?? '');
      setField('urgency', detail?.urgency ?? '');
      setField('location', detail?.location ?? '');
      setField('estimateFrom', detail?.estimateFrom !== undefined ? String(detail.estimateFrom) : '');
      setField('estimateTo', detail?.estimateTo !== undefined ? String(detail.estimateTo) : '');
      if (detail?.message !== undefined) {
        setField('message', detail.message);
      }
    };

    let lastFocus: HTMLElement | null = null;

    const open = (detail?: OpenLeadFormDetail): void => {
      if (dialog.open) return;
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      applyPreset(detail);
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      phone?.focus();
    };

    const close = (): void => {
      if (!dialog.open) return;
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
    };

    for (const trigger of document.querySelectorAll<HTMLElement>('[data-open-lead-form]')) {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open();
      });
    }

    window.addEventListener('tmt:open-lead-form', ((event: CustomEvent<OpenLeadFormDetail>) => {
      open(event.detail);
    }) as EventListener);

    dialog.querySelector('[data-lead-dialog-close]')?.addEventListener('click', close);

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    dialog.addEventListener('close', () => {
      if (lastFocus && document.contains(lastFocus)) lastFocus.focus();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLeadDialog);
  } else {
    initLeadDialog();
  }
</script>

<style>
  .lead-dialog {
    width: min(92vw, 520px);
    max-width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-lg);
  }

  .lead-dialog::backdrop {
    background: rgba(22, 19, 18, 0.55);
  }

  .lead-dialog__panel {
    position: relative;
    padding: 28px 24px 24px;
  }

  .lead-dialog__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--color-surface-alt);
    color: var(--color-ink);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lead-dialog__close:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .lead-dialog__title {
    font-size: 22px;
    font-weight: 900;
    margin-bottom: 8px;
    padding-right: 40px;
  }

  .lead-dialog__lead {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 20px;
  }
</style>
