---
import { site, categories } from '@/lib/content';
import Icon from '@/components/ui/Icon.astro';
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href="/">
          <Icon name="logo-mobile-white" size={147} />
          <span class="sr-only">The Master Time</span>
        </a>
        <p class="site-footer__tagline">
          {site.areaServed} · {site.workingHours}
        </p>
      </div>

      <nav class="site-footer__col" aria-label="Услуги">
        <h2 class="site-footer__title">Услуги</h2>
        <ul>
          {
            categories.map((category) => (
              <li>
                <a href={`/uslugi/${category.slug}`}>{category.shortTitle}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Страницы">
        <h2 class="site-footer__title">Информация</h2>
        <ul>
          <li><a href="/ceny">Цены</a></li>
          <li><a href="/kalkulyator">Калькулятор</a></li>
          <li><a href="/kontakty">Контакты</a></li>
        </ul>
      </nav>

      <div class="site-footer__col site-footer__contacts">
        <h2 class="site-footer__title">Контакты</h2>
        <a
          href={`tel:${site.phoneLink}`}
          data-track
          data-track-event="phone_click"
          data-track-params='{"placement":"footer"}'>
          {site.phoneDisplay}
        </a>
        <a
          href={site.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track
          data-track-event="instagram_click"
          data-track-params='{"placement":"footer"}'>
          Instagram
        </a>
        <a
          href={site.viberUrl}
          data-track
          data-track-event="viber_click"
          data-track-params='{"placement":"footer"}'>
          Viber
        </a>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>{site.copyright}</p>
      <a href="/politika-konfidencialnosti">Политика конфиденциальности</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: rgba(255, 255, 255, 0.85);
    padding: 56px 0 32px;
  }

  .site-footer a {
    color: rgba(255, 255, 255, 0.85);
  }

  .site-footer a:hover {
    color: #ffffff;
  }

  .site-footer__grid {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    margin-bottom: 16px;
  }

  .site-footer__tagline {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    max-width: 260px;
  }

  .site-footer__title {
    margin-bottom: 16px;
    color: #ffffff;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__col a {
    font-size: 15px;
  }

  .site-footer__contacts {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .site-footer__legal {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
  }

  .site-footer__legal a {
    color: rgba(255, 255, 255, 0.55);
  }

  .site-footer__legal a:hover {
    color: #ffffff;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    }

    .site-footer__legal {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
