---
// TODO: требует юридической проверки — текст шаблонный (demo).
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

import { site } from '@/lib/content';

const seo = {
  ...site.defaultSeo,
  title: 'Политика конфиденциальности',
  description: 'Политика обработки персональных данных сервиса The Master Time.',
  canonical: Astro.url.pathname
};

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Политика конфиденциальности' }
];

// Разделы политики. Формулировки типовые; юридическая проверка обязательна. // demo
const sections = [
  {
    id: 'data',
    title: 'Какие данные мы обрабатываем',
    body: [
      'Имя, номер телефона, текст комментария и, при необходимости, фотографии, которые вы прикрепляете к заявке.',
      'Технические данные: источник заявки, страница отправки и сведения об атрибуции (например, utm-метки), если они переданы.'
    ]
  },
  {
    id: 'purpose',
    title: 'Зачем мы обрабатываем данные',
    body: [
      'Чтобы связаться с вами, уточнить детали задачи и назвать цену.',
      'Данные используются только для обработки вашей заявки и не передаются третьим лицам для рекламы.'
    ]
  },
  {
    id: 'storage',
    title: 'Как хранятся данные',
    body: [
      'Данные хранятся в течение времени, необходимого для обработки заявки и выполнения работ.',
      'Мы принимаем разумные меры для защиты данных от несанкционированного доступа.'
    ]
  },
  {
    id: 'cookies',
    title: 'Файлы cookie',
    body: [
      'Сайт может использовать файлы cookie для хранения вашего согласия на обработку данных и для веб-аналитики.',
      'Cookie не используются для рекламного таргетинга.'
    ]
  },
  {
    id: 'rights',
    title: 'Ваши права',
    body: [
      'Вы можете запросить доступ к своим данным, их исправление или удаление.',
      'Вы можете отозвать согласие на обработку данных в любой момент.'
    ]
  },
  {
    id: 'contact',
    title: 'Как с нами связаться',
    body: [
      'По вопросам обработки данных обращайтесь по телефону или электронной почте, указанным ниже.'
    ]
  }
];
---

<BaseLayout seo={seo} noindex>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
      <h1 class="page-hero__title">Политика конфиденциальности</h1>
      <p class="page-hero__lead">
        Как мы обрабатываем персональные данные и какие у вас есть права.
      </p>
    </div>
  </section>

  <section class="privacy">
    <div class="container privacy__inner">
      <div class="privacy__operator">
        <h2 class="privacy__operator-title">Оператор</h2>
        <ul class="privacy__operator-list">
          <li><span>Название</span><strong>{site.brand}</strong></li>
          <li><span>Исполнитель</span><strong>{site.legalName}</strong></li>
          <li><span>УНП</span><strong>{site.unp}</strong></li>
          <li><span>Телефон</span><a href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a></li>
          <li><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>

      <div class="privacy__sections">
        {
          sections.map((section) => (
            <article class="privacy__section" id={section.id}>
              <h2 class="privacy__title">{section.title}</h2>
              {section.body.map((paragraph) => <p class="privacy__text">{paragraph}</p>)}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background:
      radial-gradient(1200px 480px at 85% -10%, rgba(234, 98, 73, 0.28), transparent 60%),
      var(--color-ink);
    color: #ffffff;
    padding-block: 40px 56px;
  }

  .page-hero__title {
    color: #ffffff;
    font-size: clamp(30px, 5.5vw, 52px);
    font-weight: 900;
    line-height: 1.1;
    margin-block: 20px 16px;
  }

  .page-hero__lead {
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.6;
    max-width: 680px;
  }

  .page-hero :global(.breadcrumbs),
  .page-hero :global(.breadcrumbs a) {
    color: rgba(255, 255, 255, 0.72);
  }

  .page-hero :global(.breadcrumbs a:hover) {
    color: var(--color-accent-soft);
  }

  .page-hero :global(.breadcrumbs [aria-current='page']) {
    color: #ffffff;
  }

  .page-hero :global(.breadcrumbs__item + .breadcrumbs__item::before) {
    color: rgba(255, 255, 255, 0.4);
  }

  .privacy {
    padding-block: var(--section-y);
  }

  .privacy__inner {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    align-items: start;
  }

  .privacy__operator {
    background: var(--color-surface-alt);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .privacy__operator-title {
    font-size: 18px;
    font-weight: 900;
    margin-bottom: 16px;
  }

  .privacy__operator-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .privacy__operator-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .privacy__operator-list span {
    color: var(--color-muted);
    font-size: 13px;
  }

  .privacy__operator-list strong {
    color: var(--color-ink);
    font-size: 15px;
  }

  .privacy__sections {
    display: grid;
    gap: 28px;
  }

  .privacy__title {
    font-size: 20px;
    font-weight: 900;
    margin-bottom: 12px;
  }

  .privacy__text {
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 10px;
  }

  @media (min-width: 768px) {
    .privacy__inner {
      grid-template-columns: 320px 1fr;
    }
  }
</style>
