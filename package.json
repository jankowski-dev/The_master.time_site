{
  "name": "the-master-time",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:content && astro build",
    "validate:content": "tsx scripts/validate-content.ts",
