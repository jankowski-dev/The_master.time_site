# Public site URL used for canonical links, sitemap, robots and CSRF origin.
# Local: http://localhost:4321 | Railway production: https://master-time.pro
SITE_URL=http://localhost:4321

# Server port (the Node adapter uses 4321 by default; Railway injects PORT)
PORT=4321

# Bind address for the standalone Node server (Railway: 0.0.0.0)
HOST=0.0.0.0

# Analytics / tracking (public)
PUBLIC_YM_ID=112934654
PUBLIC_GA_ID=
PUBLIC_GOOGLE_ADS_ID=

# Outgoing mail (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Example: The Master Time <site@master-time.pro> (create the mailbox / verify the sender)
MAIL_FROM=
# Example: site@master-time.pro
MAIL_TO=

# Viber notifications (webhook: https://master-time.pro/api/viber/webhook)
VIBER_AUTH_TOKEN=
VIBER_ADMIN_ID=

# CRM integration
CRM_WEBHOOK_URL=

# When set to 1, lead delivery is short-circuited for tests.
# NEVER set this in production — leads would be silently discarded.
LEAD_TEST_MODE=
